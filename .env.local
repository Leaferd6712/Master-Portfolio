# LM Studio — local AI model server (OpenAI-compatible)
# Make sure LM Studio is running with the server enabled on port 1234
LOCAL_AI_URL=http://127.0.0.1:1234

# Optional: override the model name if you load a different one in LM Studio
# LOCAL_AI_MODEL=qwen2.5-coder-3b-instruct

# FastAPI backend URL (for projects, tasks, auth, etc.)
BACKEND_API_URL=http://127.0.0.1:8000

# Gemini (dashboard Gemini AI section). Optional fallback if the UI key field is empty.
# Get a key at https://aistudio.google.com/apikey — do not commit a real key.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
